        type: UnknownEnum.Value_1,
        section: "chaptera",
        per_difficulty: false,
        key: "bru",
        hidden: true,
        hint: "???"
    }, 
    {
        song_id: 201,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: true,
        key: "nhboss1",
        hidden: true,
        hint: "Unlock from NEUTRON:HEXIMA"
    }, 
    {
        song_id: 204,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: true,
        key: "nhboss2",
        hidden: true,
        hint: "Unlock from NEUTRON:HEXIMA"
    }, 
    {
        song_id: 202,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: true,
        key: "nhboss3",
        hidden: true,
        hint: "Unlock from NEUTRON:HEXIMA"
    }, 
    {
        song_id: 203,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: true,
        key: "nhboss4",
        hidden: true,
        hint: "Unlock from NEUTRON:HEXIMA"
    }, 
    {
        song_id: 206,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: false,
        key: "nhfinal",
        hidden: true,
        hint: ""
    }, 
    {
        song_id: 200,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: false,
        key: "nhfinal",
        hidden: true,
        hint: ""
    }, 
    {
        song_id: 205,
        type: UnknownEnum.Value_1,
        section: "neutronhexima",
        per_difficulty: false,
        key: "nhfinal",
        hidden: true,
        hint: ""
    }];
    load_event_nodes();
    for (var i = 0; i < array_length(global.event_nodes); i++)
    {
        var node = global.event_nodes[i];
        if (node.type == 2)
        {
            array_push(unlockable_songs, 
            {
                song_id: node.song,
                type: UnknownEnum.Value_2,
                node_id: i,
                per_difficulty: false,
                hidden: false,
                hint: "Unlock from the Node Flowchart"
            });
        }
    }
    create_rpg_collectibles();
    var c0_songs = struct_get_names(global.c0_songs);
    for (var i = 0; i < array_length(c0_songs); i++)
    {
        var value = variable_struct_get(global.c0_songs, @@array_get@@(c0_songs, i));
        if (!value.def)
        {
            array_push(unlockable_songs, 
            {
                song_id: value.song_id,
                type: UnknownEnum.Value_1,
                section: "betweenspace",
                key: $"su_{value.song_id}",
                per_difficulty: false,
                hidden: false,
                hint: "",
                obfuscated: true,
                obfuscated_hint: "Find in Betweenspace"
            });
        }
    }
    create_store_objects();
    for (var i = 0; i < array_length(global.store_songs); i++)
    {
        var song_id = global.store_songs[i].song_id;
        array_push(unlockable_songs, 
        {
            song_id: song_id,
            type: UnknownEnum.Value_1,
            section: "shop",
            key: $"ul{song_id}",
            per_difficulty: false,
            hidden: false,
            hint: "Purchase from the shop"
        });
    }
    create_soundscan_maps();
    var soundscan_unlocks = ds_map_create();
    for (var i = 0; i < array_length(global.soundscan_maps); i++)
    {
        for (var ri = 0; ri < array_length(global.soundscan_maps[i].rewards); ri++)
        {
            var reward = global.soundscan_maps[i].rewards[ri];
            switch (reward.type)
            {
                case UnknownEnum.Value_4:
                    var ssu = ds_map_find_value(soundscan_unlocks, reward.detail);
                    if (ssu == undefined)
                    {
                        ssu = {};
                    }
                    struct_graft(ssu, 
                    {
                        song_id: reward.detail,
                        type: UnknownEnum.Value_3,
                        map_id: i,
                        ep_req: reward.ep_req,
                        per_difficulty: false,
                        hidden: false,
                        hint: "Unlock in Soundscan"
                    });
                    ds_map_set(soundscan_unlocks, reward.detail, ssu);
                    break;
                case UnknownEnum.Value_10:
                    var ssu = ds_map_find_value(soundscan_unlocks, reward.detail);
                    if (ssu == undefined)
                    {
                        ssu = {};
                    }
                    struct_graft(ssu, 
                    {
                        song_id: reward.detail,
                        enc_type: UnknownEnum.Value_3,
                        enc_map_id: i,
                        enc_ep_req: reward.ep_req,
                        enc_hint: "Unlock in Soundscan"
                    });
                    ds_map_set(soundscan_unlocks, reward.detail, ssu);
                    break;
            }
        }
    }
    for (var i = 0; i < array_length(global.soundscan_legacy_maps); i++)
    {
        for (var ri = 0; ri < array_length(global.soundscan_legacy_maps[i].rewards); ri++)
        {
            var reward = global.soundscan_legacy_maps[i].rewards[ri];
            if (reward.type == UnknownEnum.Value_4)
            {
                var ssu = ds_map_find_value(soundscan_unlocks, reward.detail);
                if (ssu == undefined)
                {
                    ssu = {};
                }
                struct_graft(ssu, 
                {
                    song_id: reward.detail,
                    type: UnknownEnum.Value_3,
                    legacy_map_id: i,
                    legacy_ep_req: reward.ep_req,
                    per_difficulty: false,
                    hidden: false,
                    hint: "Unlock in Soundscan"
                });
                ds_map_set(soundscan_unlocks, reward.detail, ssu);
            }
        }
    }
    var ssu_keys = ds_map_keys_to_array(soundscan_unlocks);
    for (var i = 0; i < array_length(ssu_keys); i++)
    {
        var u = ds_map_find_value(soundscan_unlocks, @@array_get@@(ssu_keys, i));
        u.has_legacy_unlock = struct_exists(u, "legacy_map_id");
        u.has_enc_unlock = struct_exists(u, "enc_map_id");
        if (u.has_legacy_unlock && !struct_exists(u, "map_id"))
        {
            u.map_id = -1;
            u.ep_req = infinity;
        }
        array_push(unlockable_songs, u);
    }
    ds_map_destroy(soundscan_unlocks);
    var us_map = ds_map_create();
    for (var i = 0; i < array_length(unlockable_songs); i++)
    {
        var u = unlockable_songs[i];
        if (ds_map_exists(us_map, u.song_id))
        {
            struct_graft(ds_map_find_value(us_map, u.song_id), u);
        }
        else
        {
            ds_map_add(us_map, u.song_id, u);
        }
    }
    var set_unlocks = [];
    var us_map_keys = ds_map_keys_to_array(us_map);
    for (var i = 0; i < array_length(us_map_keys); i++)
    {
        var u = ds_map_find_value(us_map, @@array_get@@(us_map_keys, i));
        while (u.song_id >= array_length(global.song_list))
        {
            array_push(global.song_list, getGenericInvalidSong(array_length(global.song_list)));
        }
        struct_graft(u, 
        {
            type: UnknownEnum.Value_0,
            per_difficulty: false,
            hint: "",
            hidden: false
        }, true);
        array_push(set_unlocks, u.song_id);
        if (!struct_exists(u, "enc_type"))
        {
            if (global.song_list[u.song_id].has_encore && (u.type != UnknownEnum.Value_1 || u.per_difficulty == false))
            {
                u.enc_type = UnknownEnum.Value_4;
                u.enc_hint = "Get at least 950,000 on FINALE";
            }
            else
            {
                u.enc_type = UnknownEnum.Value_0;
                u.enc_hint = "How are you reading this?";
            }
        }
        global.song_list[u.song_id].invalid = false;
        array_push(global.valid_song_ids, u.song_id);
        global.song_list[u.song_id].unlock = u;
    }
    ds_map_destroy(us_map);
    for (var i = 0; i < array_length(global.song_list); i++)
    {
        if (!array_contains(set_unlocks, i) && global.song_list[i].has_encore && !struct_get_fallback(global.song_list[i].unlock, "locked", false))
        {
            struct_graft(global.song_list[i].unlock, 
            {
                enc_type: UnknownEnum.Value_4,
                enc_hint: "Get at least 950,000 on FINALE"
            });
        }
    }
    ini_open(global.profile_file);
    deserialise_eventline_progress(ini_read_string("profile", "unlocked_event_nodes", ""));
    ini_open(global.profile_file);
    get_fallback_node_unlocks();
    global.unlocked_event_nodes = [];
    deserialise_eventline_progress(ini_read_string("profile", "unlocked_event_nodes_v2", ""));
    ini_open(global.profile_file);
    has_done_conversion = ini_read_real("profile", "converted_flowchartv1_progress", false);
    if (!has_done_conversion)
    {
        convert_flowchartv1_progress();
    }
    ini_close();
    create_song_unlock_times();
    global.song_list[147].unlock.hidden = unix_timestamp() < 1726376400;
    global.song_list[169].unlock.hidden = true;
    global.song_list[168].unlock.hidden = true;
    global.song_list[154].unlock.hidden = true;
    global.song_list[176].unlock.hidden = true;
    global.song_list[177].unlock.hidden = true;
    global.song_list[152].unlock.hidden = true;
}

enum UnknownEnum
{
    Value_0,
    Value_1,
    Value_2,
    Value_3,
    Value_4,
    Value_10 = 10
}
